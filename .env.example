# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase > Connect > Transaction pooler string (port 6543). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-a-long-random-string-here
